# Virtual Audience Platform Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string used by the app and migration scripts.
DATABASE_URL=postgresql://postgres:postgres@db:5432/virtual_audience

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Authentication ────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a long random string before deploying!
SESSION_SECRET=change-me-to-a-long-random-secret

# ── SRS Streaming Servers ─────────────────────────────────────────────────────
# WHIP (publishing / ingest)
SRS_WHIP_HOST=cdn2.obedtv.live
SRS_WHIP_PORT=1990
SRS_WHIP_USE_HTTPS=true
SRS_WHIP_API_PORT=1985
SRS_WHIP_API_USE_HTTPS=false

# WHEP (playback / viewing)
SRS_WHEP_HOST=cdn2.obedtv.live
SRS_WHEP_PORT=1990
SRS_WHEP_USE_HTTPS=true
SRS_WHEP_API_PORT=1985
SRS_WHEP_API_USE_HTTPS=false

# Global SRS API (statistics — defaults to WHIP settings if omitted)
# SRS_API_HOST=cdn2.obedtv.live
# SRS_API_PORT=1985
# SRS_API_USE_HTTPS=false

# Studio return-feed server (dedicated playback for studio feeds)
# Falls back to WHEP settings when not set.
# SRS_STUDIO_HOST=studio.yourdomain.com
# SRS_STUDIO_PORT=1990
# SRS_STUDIO_USE_HTTPS=true
# SRS_STUDIO_API_PORT=1985
# SRS_STUDIO_API_USE_HTTPS=false

# Multi-server WHIP load balancing (round-robin, optional)
# Each generated guest link is pinned to one server; WHEP playback follows it.
# Format: host1:port,host2:port,host3:port
# SRS_WHIP_SERVERS=srs1.yourdomain.com:1990,srs2.yourdomain.com:1990

# Legacy fallback — used when WHIP/WHEP-specific vars are absent
SRS_HOST=cdn2.obedtv.live
SRS_USE_HTTPS=true

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Required for invite emails. Get a key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
# Must be a verified sender in your SendGrid account
SENDGRID_FROM_EMAIL=alerts@yourdomain.com

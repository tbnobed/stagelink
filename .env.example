# Virtual Audience Platform — Environment Variables
# Copy this file to .env and fill in your values.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/virtual_audience

# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Authentication ─────────────────────────────────────────────────────────────
# Replace with a long random string — unique per deployment!
SESSION_SECRET=change-me-to-a-long-random-secret

# ── WHIP — Publishing / Ingest ─────────────────────────────────────────────────
# Choose ONE of the two options below.

# Option A — Single server
SRS_WHIP_HOST=srs1.yourdomain.com
SRS_WHIP_PORT=1990

# Option B — Round-robin across multiple servers (overrides Option A when set)
# Each guest link is pinned to one server; WHEP playback follows it automatically.
# Format: host:port,host:port,...
# SRS_WHIP_SERVERS=srs1.yourdomain.com:1990,srs2.yourdomain.com:1990

# HTTPS and API settings apply to all WHIP servers regardless of which option you use.
SRS_WHIP_USE_HTTPS=true
SRS_WHIP_API_PORT=1985
SRS_WHIP_API_USE_HTTPS=false

# ── WHEP — Playback / Viewing ──────────────────────────────────────────────────
SRS_WHEP_HOST=srs1.yourdomain.com
SRS_WHEP_PORT=1990
SRS_WHEP_USE_HTTPS=true
SRS_WHEP_API_PORT=1985
SRS_WHEP_API_USE_HTTPS=false

# ── Email — SendGrid ───────────────────────────────────────────────────────────
# Required for invite emails. https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
# Must be a verified sender in your SendGrid account.
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
